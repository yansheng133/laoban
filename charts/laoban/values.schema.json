{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "laoban backend chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "anthropic", "service", "persistence"],
  "definitions": {
    "name": {
      "description": "Kubernetes object name (DNS-1123 subdomain) or empty.",
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "properties": {
    "replicaCount": {
      "description": "PoC: exactly one replica (the audit spool is ReadWriteOnce). HA is a later phase.",
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": {
          "description": "Required at render time. Image digest, sha256:<64 lowercase hex>.",
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "tag": { "description": "Informational only.", "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/definitions/name" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "impersonation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userExtras": {
          "description": "Extra keys the backend may set with Impersonate-Extra-<key>.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": { "port": { "$ref": "#/definitions/port" } }
    },
    "containerPort": { "$ref": "#/definitions/port" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "liveness": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": "string" },
        "size": { "type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany"] }
        },
        "mountPath": { "type": "string", "pattern": "^/" }
      }
    },
    "anthropic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "description": "Required at render time. Name of an existing Secret with the Anthropic API key.",
          "$ref": "#/definitions/name"
        },
        "secretKey": { "type": "string", "minLength": 1 }
      }
    },
    "syslog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "port": { "$ref": "#/definitions/port" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "caConfigMap": { "$ref": "#/definitions/name" },
            "caKey": { "type": "string", "minLength": 1 },
            "clientCertSecret": { "$ref": "#/definitions/name" }
          }
        }
      }
    },
    "crdCheck": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "global": { "type": "object" }
  }
}

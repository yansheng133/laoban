{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "laoban backend chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "anthropic",
    "github",
    "config",
    "service",
    "persistence"
  ],
  "definitions": {
    "name": {
      "description": "Kubernetes object name (DNS-1123 subdomain) or empty.",
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "properties": {
    "replicaCount": {
      "description": "PoC: exactly one replica (in-memory plans, ReadWriteOnce audit spool). HA is a later phase.",
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "description": "Required at render time. Image digest, sha256:<64 lowercase hex>.",
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "tag": {
          "description": "Informational only.",
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/definitions/name"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "impersonation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Phase 1 only. When false (M0) no RBAC objects are rendered and no ServiceAccount token is mounted.",
          "type": "boolean"
        },
        "userExtras": {
          "description": "Extra keys the backend may set with Impersonate-Extra-<key>.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          }
        }
      }
    },
    "aggregatedApi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Serve the API as a Kubernetes aggregated API (TLS, verified callers). When false only the probes are served.",
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "aggregateToDefaultRoles": {
          "description": "Add the API rules to the built-in edit/admin/view ClusterRoles.",
          "type": "boolean"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "$ref": "#/definitions/port"
        }
      }
    },
    "containerPort": {
      "$ref": "#/definitions/port"
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "liveness": {
          "$ref": "#/definitions/probe"
        },
        "readiness": {
          "$ref": "#/definitions/probe"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storageClass": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)$"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod",
              "ReadWriteMany",
              "ReadOnlyMany"
            ]
          }
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "ai": {
      "description": "Where the AI calls go. Format and range are checked by the template, with a clear message.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseUrl": {
          "description": "Empty for the Anthropic API, or the base URL of an Anthropic-compatible endpoint (LAOBAN_AI_BASE_URL).",
          "type": "string"
        },
        "timeoutSeconds": {
          "description": "Upper bound for one AI call, 30 to 1800 (LAOBAN_AI_TIMEOUT_SECONDS).",
          "type": "integer"
        }
      }
    },
    "anthropic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "description": "Required at render time unless ai.baseUrl is set. Name of an existing Secret with the Anthropic API key.",
          "$ref": "#/definitions/name"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "description": "Required at render time. <owner>/<repo> the generated apps are committed to (LAOBAN_GITHUB_REPO).",
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
        },
        "existingSecret": {
          "description": "Required at render time. Name of an existing Secret with the GitHub fine-grained token (LAOBAN_GITHUB_TOKEN).",
          "$ref": "#/definitions/name"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "description": "Required at render time. Model ID (LAOBAN_MODEL): an Anthropic model ID or the endpoint's name for a local model.",
          "type": "string"
        },
        "tokenCap": {
          "description": "Monthly token cap enforced by laoban (LAOBAN_TOKEN_CAP).",
          "type": "integer",
          "minimum": 1
        },
        "targetNamespace": {
          "description": "Namespace of the generated apps (LAOBAN_TARGET_NAMESPACE).",
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "clusterId": {
          "description": "Rancher cluster ID of the cluster laoban runs in (LAOBAN_CLUSTER_ID), e.g. c-m-abcd1234. Required.",
          "type": "string",
          "maxLength": 63,
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
        },
        "language": {
          "description": "Language of the backend's messages for people (LAOBAN_LANGUAGE): en or zh-Hant.",
          "type": "string",
          "enum": ["en", "zh-Hant"]
        }
      }
    },
    "syslog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "caConfigMap": {
              "$ref": "#/definitions/name"
            },
            "caKey": {
              "type": "string",
              "minLength": 1
            },
            "clientCertSecret": {
              "$ref": "#/definitions/name"
            }
          }
        }
      }
    },
    "rounds": {
      "description": "Rounds of 意見收斂 (stored in Round resources, laoban-crd chart).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "opinionChars": {
              "description": "Lower a size limit of rounds; empty keeps the built-in value. Checked by the template (it may only be lowered), so other types reach that check and its message.",
              "type": [
                "null",
                "number",
                "string"
              ]
            },
            "replyChars": {
              "description": "Lower a size limit of rounds; empty keeps the built-in value. Checked by the template (it may only be lowered), so other types reach that check and its message.",
              "type": [
                "null",
                "number",
                "string"
              ]
            },
            "roundChars": {
              "description": "Lower a size limit of rounds; empty keeps the built-in value. Checked by the template (it may only be lowered), so other types reach that check and its message.",
              "type": [
                "null",
                "number",
                "string"
              ]
            },
            "opinions": {
              "description": "Lower a size limit of rounds; empty keeps the built-in value. Checked by the template (it may only be lowered), so other types reach that check and its message.",
              "type": [
                "null",
                "number",
                "string"
              ]
            },
            "replies": {
              "description": "Lower a size limit of rounds; empty keeps the built-in value. Checked by the template (it may only be lowered), so other types reach that check and its message.",
              "type": [
                "null",
                "number",
                "string"
              ]
            }
          }
        }
      }
    },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "description": "Fail rendering unless the laoban CRDs (laoban-crd chart) are installed. Not needed in M0.",
          "type": "boolean"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "global": {
      "type": "object"
    }
  }
}
